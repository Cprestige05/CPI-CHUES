# ─── Mon Espace — backend indépendant (server/) ──────────────────────────────
# Copiez ce fichier en `.env` (ignoré par Git) et ajustez si besoin.
# AUCUNE de ces valeurs ne référence l'ancien système (PocketBase / :8090 / cpi-chues.com).

# Port du backend (imposé pour ce projet)
PORT=8787

# Environnement : development | production
NODE_ENV=development

# Origine autorisée du front (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Chemins locaux du backend (relatifs à server/)
DATABASE_FILE=./data/app.db
STORAGE_DIR=./storage/documents

# Sécurité des cookies de session
SESSION_COOKIE_NAME=mon_espace_sid
SESSION_TTL_HOURS=12
# `Secure` est forcé automatiquement en production.

# Limites documentaires
MAX_UPLOAD_MB=10

# Durées de validité des jetons (heures)
EMAIL_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=2

# Limitation des tentatives de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
