{
  "name": "mon-espace-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend indépendant (Node/Express + SQLite) du portail Mon Espace. Aucune connexion à l'ancien système.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "create-admin": "tsx src/cli/createAdmin.ts",
    "create-agent": "tsx src/cli/createAdmin.ts --role=AGENT_CPI",
    "dev-mail": "tsx src/cli/devMail.ts",
    "maintenance:check": "tsx src/cli/maintenance.ts check",
    "maintenance:reset": "tsx src/cli/maintenance.ts reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "hash-wasm": "^4.12.0",
    "libsql": "^0.5.29",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.1",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
